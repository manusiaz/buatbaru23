# ====== WAJIB ======
# Koneksi PostgreSQL di VPS kamu (PostgreSQL 13+). Tabel dibuat otomatis saat app start.
# Postgres di host yang sama & app via Docker: pakai host.docker.internal sebagai host.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/NAMA_DB
# Isi "require" kalau database mewajibkan SSL
DATABASE_SSL=
# URL publik aplikasi (dipakai di link galeri & pesan WhatsApp), tanpa garis miring di akhir
BASE_URL=https://galeri.domainkamu.com
# String acak minimal 32 karakter. JANGAN diganti setelah ada data (link & PIN terenkripsi pakai ini).
# Buat dengan: openssl rand -base64 48
APP_SECRET=
# (wajib minimal 32 karakter; app menolak start tanpa ini)

# ====== Server ======
PORT=3000
NODE_ENV=production
# Folder pratinjau & logo (di Docker sudah /data, simpan di volume)
# DATA_DIR=/data
# Jumlah reverse proxy di depan app (Nginx/Caddy/Traefik/Cloudflare Tunnel = 1). JANGAN isi "true":
# klien bisa memalsukan X-Forwarded-For dan melewati kunci PIN & rate limit.
# Tanpa proxy (akses langsung ke port app) isi "false".
TRUST_PROXY=1
# Tutup pendaftaran studio baru (false) bila aplikasi hanya untuk studiomu sendiri
ALLOW_REGISTRATION=true
APP_NAME=Galeri Seleksi
# Matikan sumber "foto contoh" setelah selesai uji coba
ALLOW_DEMO_SOURCE=true

# ====== Google Drive (lihat README) ======
# Isi JSON key service account (boleh di-base64), atau path file-nya
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
# API key (untuk folder "link publik" dan Google Picker)
GOOGLE_API_KEY=
# OAuth Client ID (Web) untuk "Masuk dengan Google" + "Pilih dari Google Drive"
GOOGLE_CLIENT_ID=
# Nomor project Google Cloud (Project number), untuk Picker
GOOGLE_APP_ID=

# ====== Email notifikasi (opsional) ======
# contoh: smtps://user:pass@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM="Galeri Seleksi <no-reply@domainkamu.com>"

# ====== Langganan studio (F-46) ======
# false (default) = semua fitur terbuka tanpa batas, cocok untuk satu studio sendiri.
# true = SaaS: paket Gratis/Starter/Pro/Bisnis dengan batas sesi & pengguna.
BILLING_ENABLED=false
# Super admin TIDAK diatur lewat env. Daftar akun dulu, lalu di server jalankan:
#   docker compose exec app node scripts/superadmin.js tambah email@kamu.com
# Paket dibayar dari SALDO studio. Saldo di-top up lewat QRIS statis milikmu
# (unggah gambar QRIS di menu Super admin), lalu super admin menyetujui setiap top up secara manual.
# Nominal top up yang boleh dipilih (Rupiah, pisahkan koma):
TOPUP_NOMINAL=50000,100000,250000,500000,1000000

# ====== Pembayaran online Midtrans (F-35: pelanggan bayar foto tambahan ke studio; opsional) ======
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=false
# Di dashboard Midtrans, set Payment Notification URL ke: {BASE_URL}/api/webhooks/midtrans

# ====== WhatsApp Business Cloud API (F-16) ======
# Nomor platform hanya dipakai studio yang diizinkan super admin; studio lain memakai kredensial WA miliknya sendiri.
WA_CLOUD_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v21.0
# Nama template yang sudah disetujui Meta (bahasa: WA_TEMPLATE_LANG).
# Template link: {{1}} nama, {{2}} studio, {{3}} link, {{4}} PIN, {{5}} kuota, {{6}} tenggat
WA_TEMPLATE_LINK=
# Template hasil: {{1}} nama, {{2}} judul, {{3}} link hasil
WA_TEMPLATE_HASIL=
WA_TEMPLATE_LANG=id
